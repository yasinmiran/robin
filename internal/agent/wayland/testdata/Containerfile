FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    mutter gnome-shell xdg-desktop-portal xdg-desktop-portal-gnome \
    pipewire pipewire-bin pipewire-pulse pulseaudio-utils wireplumber gstreamer1.0-pipewire gstreamer1.0-tools \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    dbus dbus-daemon dbus-user-session libglib2.0-bin \
    libgl1-mesa-dri libegl-mesa0 mesa-vulkan-drivers \
    wev foot python3-gi gir1.2-gtk-4.0 gsettings-desktop-schemas \
    procps psmisc ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends python3-gi-cairo \
 && rm -rf /var/lib/apt/lists/*
COPY system-bus.conf /etc/robin-system-bus.conf
ENV LANG=C.UTF-8
USER ubuntu
