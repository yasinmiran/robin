#!/bin/bash
# Runs a command against the agent's display and sound server:
# rj-x xdotool getdisplaygeometry
# An attached agent has no display of its own; then it is rj's desktop (rj-live).
set -euo pipefail

if dir=$(rj-rundir 2>/dev/null); then
  DISPLAY=$(<"$dir/display")
  if [[ -f $dir/Xauthority ]]; then
    export XAUTHORITY=$dir/Xauthority
  fi
elif [[ -f $HOME/.rj-live/display ]]; then
  DISPLAY=$(<"$HOME/.rj-live/display")
  export XAUTHORITY=$HOME/.Xauthority
else
  rj-rundir
fi
export DISPLAY
# The session's private sound server, as its programs see it.
if [[ -n ${dir:-} && -S $dir/pulse/native ]]; then
  export PULSE_SERVER=unix:$dir/pulse/native PULSE_COOKIE=$dir/pulse/cookie
elif [[ -S /run/user/$(id -u)/pulse/native ]]; then
  # Attached: the user's own sound server, where its desktop plays.
  export XDG_RUNTIME_DIR=/run/user/$(id -u)
fi
exec "$@"
