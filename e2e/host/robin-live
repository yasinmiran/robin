#!/bin/bash
# robin's own desktop, for the attach scenario: the session a user would have
# running before robin comes along.
#
#   robin-live start   start Xvfb on :5 with its cookie in ~/.Xauthority, as
#                   startx does, split into two monitors, then xterm,
#                   openbox and the user's pulseaudio; save its state
#   robin-live state   print what an attached session must leave as it found it
#   robin-live before  print the state saved at start
set -euo pipefail

num=5
dir=$HOME/.robin-live

state() {
  export DISPLAY=:$num XAUTHORITY=$HOME/.Xauthority
  echo "Xvfb $(pgrep -u robin -x Xvfb) openbox $(pgrep -u robin -x openbox) xterm $(pgrep -u robin -x xterm) pulseaudio $(pgrep -u robin -x pulseaudio)"
  echo "geometry $(xdotool getdisplaygeometry)"
  echo "monitors $(xrandr --listmonitors | tail -n +2 | tr -s ' ' | tr '\n' ';')"
  xset q | sed -n '/auto repeat:/p;/auto repeating keys:/,/bell percent/p' | sed 's/ *bell percent.*//;s/ *key click.*//'
  echo "core keymap $(xmodmap -pke | sha256sum | cut -c1-16)"
  echo "xkb keymap $(xkbcomp -xkb "$DISPLAY" - 2>/dev/null | sha256sum | cut -c1-16)"
}

start() {
  mkdir -p "$dir"
  touch "$HOME/.Xauthority"
  xauth -q -f "$HOME/.Xauthority" add ":$num" . "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  export DISPLAY=:$num XAUTHORITY=$HOME/.Xauthority
  # setsid -f and no inherited descriptors, or the ssh that runs this never returns.
  # A wide screen for two monitors: LEFT 1280x800, the primary, and RIGHT
  # 1024x768 beside it, the way a laptop with an external screen looks.
  # -noreset keeps them when the last client of the moment disconnects.
  setsid -f Xvfb ":$num" -screen 0 2304x800x24 -noreset -auth "$XAUTHORITY" -nolisten tcp </dev/null >"$dir/Xvfb.log" 2>&1
  for _ in $(seq 100); do
    xdpyinfo >/dev/null 2>&1 && break
    sleep 0.1
  done
  xrandr --setmonitor '*LEFT' 1280/339x800/212+0+0 screen
  xrandr --setmonitor RIGHT 1024/271x768/203+1280+0 none
  # The terminal first: openbox adopts it (see the ADR on spawn order). In
  # UTF-8, as a display manager's session would be: ssh brings no locale.
  LANG=C.UTF-8 setsid -f xterm -geometry 80x24+60+60 </dev/null >"$dir/xterm.log" 2>&1
  xdotool search --sync --onlyvisible --class xterm >/dev/null
  setsid -f openbox </dev/null >"$dir/openbox.log" 2>&1
  # A logged-in desktop comes with its user's sound server, which an attached
  # session records.
  XDG_RUNTIME_DIR=/run/user/$(id -u) setsid -f pulseaudio --daemonize=no --exit-idle-time=-1 -n \
    --load="module-null-sink sink_name=desk rate=48000 channels=2 norewinds=1" \
    --load=module-native-protocol-unix </dev/null >"$dir/pulseaudio.log" 2>&1
  for _ in $(seq 100); do
    [[ -S /run/user/$(id -u)/pulse/native ]] && break
    sleep 0.1
  done
  for _ in $(seq 100); do
    xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id' && break
    sleep 0.1
  done
  echo ":$num" >"$dir/display"
  state >"$dir/before"
}

case ${1:-} in
  start) start ;;
  state) state ;;
  before) cat "$dir/before" ;;
  *) echo "usage: robin-live start|state|before" >&2; exit 2 ;;
esac
